   138	### Fix A — `getFolderTokens`: hard cap + concurrency-limited encode + yield
   139	
   140	`src/atpath-core.js:147-168`. Replace the body of `getFolderTokens` with:
   141	
   142	1. Walk the subtree as today, but **count files first** (no promises started).
   143	2. If `count > settings.maxFolderFiles` (default 500): memoize a sentinel
   144	   `{ overCap: true, fileCount: count }` and return immediately.
   145	3. Otherwise, process the path list in batches of `settings.folderEncodeBatchSize`
   146	   (default 4). Between batches, `await new Promise(r => setTimeout(r, 0))`
   147	   to release the main thread.
   148	4. Sum and memoize as today.
   149	
   150	Pseudocode:
   151	
   152	```javascript
   153	async function getFolderTokens(folderPath) {
   154	  const folder = app.vault.getAbstractFileByPath(folderPath);
   155	  if (!(folder instanceof TFolder)) return 0;
   156	  const memo = folderTokenMemo.get(folderPath);
   157	  if (memo !== undefined) return memo;
   158	
   159	  const settings = plugin.settings || {};
   160	  const sizeCapBytes = (settings.maxFileSizeMB || 5) * 1024 * 1024;
   161	  const maxFiles = settings.maxFolderFiles || 500;
   162	  const batchSize = settings.folderEncodeBatchSize || 4;
   163	
   164	  const paths = [];
   165	  (function walk(node) {
   166	    for (const c of node.children) {
   167	      if (c instanceof TFolder) walk(c);
   168	      else if (c instanceof TFile && !isIgnored(c.path) && c.stat.size <= sizeCapBytes) {
   169	        paths.push(c.path);
   170	      }
   171	    }
   172	  })(folder);
   173	
   174	  if (paths.length > maxFiles) {
   175	    const sentinel = { overCap: true, fileCount: paths.length };
   176	    folderTokenMemo.set(folderPath, sentinel);
   177	    return sentinel;
   178	  }
   179	
   180	  let total = 0;
   181	  for (let i = 0; i < paths.length; i += batchSize) {
   182	    const slice = paths.slice(i, i + batchSize);
   183	    const counts = await Promise.all(slice.map(getFileTokens));
   184	    for (const n of counts) total += n || 0;
   185	    if (i + batchSize < paths.length) {
   186	      await new Promise(r => setTimeout(r, 0));
   187	    }
   188	  }
   189	  folderTokenMemo.set(folderPath, total);
   190	  return total;
   191	}
